</main>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var f = document.getElementById('tcmFounderCta');
    if (f) {
      f.addEventListener('submit', function () {
        var p = document.getElementById('founder-cta-phone');
        if (p && p.value && p.value.trim().length >= 10) {
          if (typeof window.openEnquiry === 'function') { window.openEnquiry('Free Demo'); }
        }
      });
    }
    var track = document.querySelector('[data-team-track]');
    if (!track) return;
    var prev = document.querySelector('[data-team-prev]');
    var next = document.querySelector('[data-team-next]');
    var hint = document.querySelector('[data-team-hint]');
    var firstCard = track.querySelector('article');
    function step() {
      if (firstCard) {
        var gap = 48;
        if (window.matchMedia('(max-width: 640px)').matches) gap = 24;
        else if (window.matchMedia('(max-width: 1024px)').matches) gap = 36;
        return firstCard.offsetWidth + gap;
      }
      return Math.max(track.clientWidth * 0.8, 280);
    }
    function sync() {
      if (track.scrollWidth > track.clientWidth + 2) {
        if (prev) prev.disabled = track.scrollLeft <= 4;
        if (next) next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 6;
        if (hint) hint.style.visibility = 'visible';
      } else {
        if (prev) prev.disabled = true;
        if (next) next.disabled = true;
        if (hint) hint.style.visibility = 'hidden';
      }
    }
    function goNext() {
      if (!track) return;
      if (track.scrollWidth > track.clientWidth + 4) {
        if (track.scrollLeft >= track.scrollWidth - track.clientWidth - 6) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: step(), behavior: 'smooth' });
        }
      } else {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      }
    }
    function goPrev() { track.scrollBy({ left: -step(), behavior: 'smooth' }); }
    if (prev) prev.addEventListener('click', goPrev);
    if (next) next.addEventListener('click', goNext);
    if (hint) hint.addEventListener('click', goNext);
    track.addEventListener('scroll', sync);
    window.addEventListener('resize', sync);
    track.querySelectorAll('img').forEach(function (im) { if (!im.complete) { im.addEventListener('load', function () { setTimeout(sync, 80); }); } });
    window.addEventListener('load', sync);
    setTimeout(sync, 150);
    setTimeout(sync, 600);
    var down = false, sx = 0, sl = 0;
    track.addEventListener('mousedown', function (e) { down = true; sx = e.pageX; sl = track.scrollLeft; track.classList.add('cursor-grabbing'); });
    window.addEventListener('mouseup', function () { down = false; track.classList.remove('cursor-grabbing'); });
    track.addEventListener('mouseleave', function () { down = false; });
    track.addEventListener('mousemove', function (e) { if (!down) return; e.preventDefault(); track.scrollLeft = sl - (e.pageX - sx); });
  });
</script>

